rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function role() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isSignedIn() && role() == 'admin';
    }

    // Coiffeur ou admin : les deux voient le planning partagé et valident
    // les paniers (l'admin généralise le coiffeur, cf. cas d'utilisation).
    function isStaff() {
      return isSignedIn() && role() in ['coiffeur', 'admin'];
    }

    // --- Comptes ---

    match /users/{uid} {
      allow read: if isSelf(uid) || isAdmin();

      // Un compte ne peut jamais s'auto-promouvoir admin : le rôle
      // choisissable par soi-même est limité à client/coiffeur. Devenir
      // admin ne se fait que par un admin existant (isAdmin(), illimité).
      allow create: if isSelf(uid) && request.resource.data.role in ['client', 'coiffeur'];
      allow update: if isAdmin()
        || (isSelf(uid) && resource.data.role != 'admin' && request.resource.data.role in ['client', 'coiffeur']);
    }

    match /clients/{uid} {
      allow read: if isSelf(uid) || isStaff();
      allow create: if isSelf(uid) || isAdmin();
      allow update: if isSelf(uid) || isStaff();
    }

    match /coiffeurs/{uid} {
      allow read: if isSignedIn();
      allow create: if isSelf(uid) || isAdmin();
      allow update: if isAdmin()
        || (isSelf(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'workingHours']));
      allow delete: if isAdmin();
    }

    // --- Catalogue ---

    match /services_produits/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // --- Créneaux ---
    // Un créneau n'existe QUE lorsqu'il est réservé (son absence = libre).
    // Aucune mise à jour n'est permise : seulement create (réserver) et
    // delete (libérer, à l'annulation) — voir lib/slots.ts.
    match /creneaux/{slotId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.status == 'reserve'
        && request.resource.data.reservationId is string
        && get(/databases/$(database)/documents/reservations/$(request.resource.data.reservationId)).data.clientId == request.auth.uid
        && get(/databases/$(database)/documents/reservations/$(request.resource.data.reservationId)).data.coiffeurId == request.resource.data.coiffeurId
        && get(/databases/$(database)/documents/reservations/$(request.resource.data.reservationId)).data.date == request.resource.data.date;

      allow delete: if isSignedIn()
        && (isStaff()
          || get(/databases/$(database)/documents/reservations/$(resource.data.reservationId)).data.clientId == request.auth.uid);
    }

    // --- Réservations ---

    match /reservations/{id} {
      allow read: if isSignedIn() && (resource.data.clientId == request.auth.uid || isStaff());

      // Créée par le client lui-même, uniquement au statut initial attendu :
      // 'confirmee' pour une réservation avec créneau, ou 'en_attente' pour
      // une commande produits seuls (sans créneau à attendre).
      allow create: if isSignedIn()
        && request.resource.data.clientId == request.auth.uid
        && (
          request.resource.data.status == 'confirmee'
          || (request.resource.data.status == 'en_attente' && request.resource.data.coiffeurId == null)
        );

      allow update: if isSignedIn() && (
        (isStaff() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
        || (
          resource.data.clientId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status == 'annulee'
          && resource.data.status in ['confirmee', 'en_attente']
        )
      );
    }

    // --- Avis ---

    match /reviews/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.clientId == request.auth.uid;
    }
  }
}
